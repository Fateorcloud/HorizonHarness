# Copy to .env for local live E2E runs. Never commit real API keys.

# Copy this file to `.env`. Keep one provider endpoint/key in `.env`; switch
# models by changing only OPENAI_MODEL between runs.
# NVIDIA API Catalog hosted NIM is the default OpenAI-compatible endpoint.
OPENAI_MODEL=your-nvidia-model-id
OPENAI_AUTH_TOKEN=

# Optional: the three-key Terminal-Bench Baseline launcher assigns one key to
# each six-task shard. The first shard uses OPENAI_AUTH_TOKEN above.
OPENAI_AUTH_TOKEN_2=
OPENAI_AUTH_TOKEN_3=

# Optional: three additional keys reserved for the V4 Flash Terminus-2
# Baseline, so its shards can run without replacing the V4 Pro key group.
OPENAI_AUTH_TOKEN_4=
OPENAI_AUTH_TOKEN_5=
OPENAI_AUTH_TOKEN_6=

# OpenAI-compatible endpoint. For NVIDIA API Catalog, keep this URL.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional for eval adapters. Use openai-responses for the Responses API.
HORIZON_API_KIND=openai-chat

# Optional: reasoning depth. Set on the provider; the adapter maps this single
# knob to whatever each model/API expects (Chat reasoning_effort, Responses
# reasoning.effort, Anthropic adaptive/output_config or thinking.budget_tokens).
# Values: minimal | low | medium | high | xhigh.
HORIZON_REASONING_EFFORT=

# Agent assembly axes.
HORIZON_CAPABILITIES=bash,read,task
HORIZON_WORKFLOW=single

# Optional: write the live Responses e2e compact trace to this path.
E2E_TRACE_PATH=

# Optional for ProgramBench scoring (evals/programbench/evaluate_submissions.py).
# The official `programbench eval` downloads its test blobs from the
# `programbench/ProgramBench-Tests` HF dataset via huggingface-hub. Set this if
# that dataset needs auth (gated/private) or to dodge anonymous rate limits.
# Inference-time runs never use it.
HF_TOKEN=
